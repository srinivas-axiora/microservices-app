# Global Application Security
JWT_SECRET=your_jwt_secret_key_here

# Catalog Service Database (PostgreSQL)
CATALOG_DB_HOST=postgres_catalog
CATALOG_DB_PORT=5432
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=your_catalog_db_password
CATALOG_DB_NAME=catalogdb

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres_catalog:5432/catalogdb
SPRING_DATASOURCE_USERNAME=catalog_user
SPRING_DATASOURCE_PASSWORD=your_catalog_db_password

# Cart Service Database (MongoDB)
CART_MONGO_HOST=mongo_cart
CART_MONGO_PORT=27017
CART_MONGO_USER=cart_user
CART_MONGO_PASSWORD=your_cart_mongo_password
CART_MONGO_DB=cartdb

MONGO_URI=mongodb://cart_user:your_cart_mongo_password@mongo_cart:27017/cartdb?authSource=admin

# Shipping Service Database (PostgreSQL)
SHIPPING_DB_HOST=postgres_shipping
SHIPPING_DB_PORT=5432
SHIPPING_DB_USER=shipping_user
SHIPPING_DB_PASSWORD=your_shipping_db_password
SHIPPING_DB_NAME=shippingdb

POSTGRES_URI=postgres://shipping_user:your_shipping_db_password@postgres_shipping:5432/shippingdb
